{
  "name": "math-notes",
  "private": true,
  "version": "0.1.0",
  "description": "Turn naturally written lecture notes into readable text with typeset mathematics.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "npm run lint && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview",
    "preview:cloudflare": "npm run build && wrangler dev",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:stop": "supabase stop",
    "db:push": "supabase db push --linked",
    "db:types": "node scripts/generate-supabase-types.mjs --linked",
    "db:types:local": "node scripts/generate-supabase-types.mjs --local",
    "db:deploy": "npm run db:push && npm run db:types"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@vitejs/plugin-react": "6.1.2",
    "katex": "0.19.1",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/katex": "0.16.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "supabase": "2.122.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "wrangler": "4.155.0"
  }
}
